---
interface Props {
  label: string;
  icon?: string;
}

const { label, icon } = Astro.props;
---

<li class="flex items-center gap-3 rounded-lg border border-border bg-card px-3 py-2">
  {
    icon && (
      <img
        src={icon}
        width="24"
        height="24"
        loading="lazy"
        decoding="async"
        alt=""
        aria-hidden="true"
        class="size-6 shrink-0"
      />
    )
  }
  <span class="text-sm text-card-foreground">{label}</span>
</li>
