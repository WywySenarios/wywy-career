---
import SkillCard from "@/components/SkillCard.astro";
import { skillCardIcon } from "@/lib/skill-cards";
import { formatSkillItems, isCardSkillGroup } from "@/lib/skills";
import type { SkillGroup } from "@/lib/skills-schema";

interface Props {
  groups: Pick<SkillGroup, "id" | "label" | "items">[];
}

const { groups } = Astro.props;
---

{
  groups.map((group) => (
    <section class="space-y-1">
      <h2 class="text-lg font-semibold text-foreground">{group.label}</h2>
      {isCardSkillGroup(group.id) ? (
        <ul role="list" class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {group.items.map((item) => (
            <SkillCard label={item} icon={skillCardIcon(item)} />
          ))}
        </ul>
      ) : (
        <p class="text-sm text-muted-foreground">
          {formatSkillItems(group.items)}
        </p>
      )}
    </section>
  ))
}
