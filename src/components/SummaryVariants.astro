---
import type { SummaryEntry } from "@/lib/cv-entries";
import { isVisible } from "@/lib/stream-predicates";

interface Props {
  variants: SummaryEntry[];
  activeStream: string;
}

const { variants, activeStream } = Astro.props;
---

{
  variants.map((variant) => (
    <p
      class="text-sm text-muted-foreground"
      data-streams={variant.streams.join(",")}
      data-stream-atom
      hidden={!isVisible(variant.streams, activeStream)}
    >
      {variant.text}
    </p>
  ))
}
